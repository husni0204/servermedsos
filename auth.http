### =================================================================
#                      MEDSOS API — TEST SUITE
#  Gunakan VS Code extension "REST Client" untuk menjalankan
#  Run: Send All Requests (Ctrl+Alt+R) secara berurutan
# =================================================================

@baseUrl = http://localhost:3000


### =================================================================
# 1️⃣ AUTH — Register
# =================================================================

### Register — Success
# @name registerSuccess
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "fullname": "Test User Baru",
    "username": "testuser123",
    "email": "testuser123@test.com",
    "password": "password123"
}

### Register — Duplicate Email
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "fullname": "Test User Lain",
    "username": "testuser456",
    "email": "testuser123@test.com",
    "password": "password123"
}

### Register — Duplicate Username
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "fullname": "Test User Lain",
    "username": "testuser123",
    "email": "testuser456@test.com",
    "password": "password123"
}

### Register — Validation Error (email invalid)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "fullname": "Test User",
    "username": "testuser789",
    "email": "bukanemail",
    "password": "123"
}

### Register — Validation Error (fullname < 6)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "fullname": "Tes",
    "username": "testuser789",
    "email": "testuser789@test.com",
    "password": "password123"
}

### Register — Validation Error (password < 8)
