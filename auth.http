# ✅ RESPONSE FORMAT VERIFICATION
#  Semua response harus mengikuti format:
#    Success: { "success": true,  "message": "...", "data": ... }
#    Error:   { "success": false, "message": "..." }
#    Check:   { "success": true,  "message": "...", "data": true/false }
# =================================================================
